# Copy to apps/api/.env for running the API outside Docker (make dev-api).
# Defaults in app/core/config.py already match local Supabase.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Supabase (from `supabase status`). The anon key is public by design.
SUPABASE_URL=http://127.0.0.1:54321
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres



# API
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
RATE_LIMIT_PER_MINUTE=120

# AI providers: local | mock. Local providers arrive in Milestone 3; use mock until then.
STT_PROVIDER=mock
PRONUNCIATION_PROVIDER=mock
FLUENCY_PROVIDER=mock
TTS_PROVIDER=mock
GRAMMAR_PROVIDER=mock
EMBEDDER_PROVIDER=mock
LLM_PROVIDER=mock
LLM_MODEL=qwen3:4b
