{
  "components": {
    "schemas": {
      "DeleteAccountIn": {
        "properties": {
          "confirm": {
            "const": "DELETE",
            "title": "Confirm",
            "type": "string"
          }
        },
        "required": [
          "confirm"
        ],
        "title": "DeleteAccountIn",
        "type": "object"
      },
      "ExerciseCheckIn": {
        "properties": {
          "answer": {
            "maxLength": 500,
            "title": "Answer",
            "type": "string"
          }
        },
        "required": [
          "answer"
        ],
        "title": "ExerciseCheckIn",
        "type": "object"
      },
      "ExerciseResultOut": {
        "properties": {
          "correct": {
            "title": "Correct",
            "type": "boolean"
          },
          "correct_answer": {
            "title": "Correct Answer",
            "type": "string"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "correct",
          "correct_answer",
          "explanation"
        ],
        "title": "ExerciseResultOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LessonCheckIn": {
        "properties": {
          "answers": {
            "additionalProperties": {
              "type": "string"
            },
            "maxProperties": 50,
            "title": "Answers",
            "type": "object"
          },
          "duration_seconds": {
            "anyOf": [
              {
                "maximum": 21600.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Seconds"
          }
        },
        "required": [
          "answers"
        ],
        "title": "LessonCheckIn",
        "type": "object"
      },
      "LessonCheckOut": {
        "properties": {
          "pass_ratio": {
            "title": "Pass Ratio",
            "type": "number"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ExerciseResultOut"
            },
            "title": "Results",
            "type": "array"
          },
          "score_ratio": {
            "title": "Score Ratio",
            "type": "number"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "score_ratio",
          "passed",
          "pass_ratio",
          "status",
          "results"
        ],
        "title": "LessonCheckOut",
        "type": "object"
      },
      "LessonStartOut": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "LessonStartOut",
        "type": "object"
      },
      "OnboardingIn": {
        "properties": {
          "daily_goal_minutes": {
            "default": 30,
            "enum": [
              15,
              30,
              60,
              120
            ],
            "title": "Daily Goal Minutes",
            "type": "integer"
          },
          "exam_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exam Date"
          },
          "level_code": {
            "description": "Learning level 1-6",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Level Code",
            "type": "integer"
          },
          "target_score": {
            "description": "Target PTE score the learner is aiming for",
            "maximum": 90.0,
            "minimum": 10.0,
            "title": "Target Score",
            "type": "integer"
          }
        },
        "required": [
          "level_code",
          "target_score"
        ],
        "title": "OnboardingIn",
        "type": "object"
      },
      "OnboardingOut": {
        "properties": {
          "daily_goal_minutes": {
            "title": "Daily Goal Minutes",
            "type": "integer"
          },
          "exam_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exam Date"
          },
          "level_code": {
            "title": "Level Code",
            "type": "integer"
          },
          "onboarding_completed": {
            "title": "Onboarding Completed",
            "type": "boolean"
          },
          "target_score": {
            "title": "Target Score",
            "type": "integer"
          }
        },
        "required": [
          "level_code",
          "target_score",
          "exam_date",
          "daily_goal_minutes",
          "onboarding_completed"
        ],
        "title": "OnboardingOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "REST actions for TutorBot English AI. Reads use GraphQL at /graphql.",
    "title": "TutorBot English AI API",
    "version": "0.1.0"
  },
