# Copy to .env.local (make setup does this). Values below are the public local Supabase defaults.
# Browser-visible values:
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-status
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side only (inside Docker these point at host.docker.internal / api):
SUPABASE_URL_INTERNAL=http://127.0.0.1:54321
API_URL_INTERNAL=http://127.0.0.1:8000
