    {
      "slug": "word-stress",
      "kind": "stress",
      "title": "Word stress",
      "symbols": [],
      "tip": "In words with two or more syllables, one syllable is stronger: longer, louder and higher. Many two-syllable nouns stress the first syllable (TAble); many two-syllable verbs stress the second (reLAX). A dictionary shows stress with a mark ˈ before the stressed syllable.",
      "examples": [
        "TAble",
        "HAPpy",
        "reLAX",
        "beGIN",
        "PHOtograph",
        "phoTOgraphy"
      ],
      "drill": [
        {
          "id": "word-stress-k1",
          "type": "choose",
          "prompt": "Which syllable is stressed in 'teacher'?",
          "options": [
            "TEA-cher",
            "tea-CHER"
          ],
          "answer": "TEA-cher",
          "explanation": "Two-syllable nouns often stress the first syllable."
        },
        {
          "id": "word-stress-k2",
          "type": "choose",
          "prompt": "Which syllable is stressed in 'begin'?",
          "options": [
            "BE-gin",
            "be-GIN"
          ],
          "answer": "be-GIN",
          "explanation": "Two-syllable verbs often stress the second syllable."
        },
        {
          "id": "word-stress-k3",
          "type": "choose",
          "prompt": "Which syllable is stressed in 'banana'?",
          "options": [
            "BA-na-na",
            "ba-NA-na",
            "ba-na-NA"
          ],
          "answer": "ba-NA-na",
          "explanation": "The middle syllable is strong; the others are schwa."
        },
        {
          "id": "word-stress-k4",
          "type": "choose",
          "prompt": "Which syllable is stressed in 'photography'?",
          "options": [
            "PHO-to-gra-phy",
            "pho-TO-gra-phy",
            "pho-to-GRA-phy"
          ],
          "answer": "pho-TO-gra-phy",
          "explanation": "Words ending in -graphy stress the syllable before it."
        },
        {
          "id": "word-stress-k5",
          "type": "choose",
          "prompt": "Which syllable is stressed in 'education'?",
          "options": [
            "E-du-ca-tion",
            "e-du-CA-tion",
            "e-DU-ca-tion"
          ],
          "answer": "e-du-CA-tion",
          "explanation": "Words ending in -tion stress the syllable just before it."
        },
        {
          "id": "word-stress-k6",
          "type": "choose",
          "prompt": "In 'a REcord' (noun) and 'to reCORD' (verb), what changes?",
          "options": [
            "the stress",
            "the spelling",
            "nothing"
          ],
          "answer": "the stress",
          "explanation": "Some words change stress between noun and verb."
        }
      ]
    },
    {
      "slug": "sentence-stress",
      "kind": "stress",
      "title": "Sentence stress",
      "symbols": [],
      "tip": "In a sentence we stress the words that carry meaning (nouns, main verbs, adjectives, adverbs, negatives) and say small grammar words (a, the, to, and, of, can) quickly and weakly.",
      "examples": [
        "I WANT to GO HOME.",
        "She's BOUGHT a NEW CAR.",
        "I CAN'T COME toNIGHT."
      ],
      "drill": [
        {
          "id": "sentence-stress-k1",
          "type": "choose",
          "prompt": "Which words are usually stressed in 'I need a cup of tea'?",
          "options": [
            "need, cup, tea",
            "I, a, of",
            "a, of"
          ],
          "answer": "need, cup, tea",
          "explanation": "Content words carry the stress."
        },
        {
          "id": "sentence-stress-k2",
          "type": "choose",
          "prompt": "Which kind of word is usually NOT stressed?",
          "options": [
            "the",
            "house",
            "beautiful"
          ],
          "answer": "the",
          "explanation": "Articles are grammar words and are usually weak."
        },
        {
          "id": "sentence-stress-k3",
          "type": "choose",
          "prompt": "Are negatives like 'can't' usually stressed?",
          "options": [
            "yes",
            "no"
          ],
          "answer": "yes",
          "explanation": "Negatives carry important meaning, so they are stressed."
        },
        {
          "id": "sentence-stress-k4",
          "type": "choose",
          "prompt": "In 'She's BOUGHT a NEW CAR', why is 'a' weak?",
          "options": [
            "it is a grammar word",
            "it is a verb",
            "it is a negative"
          ],
          "answer": "it is a grammar word",
          "explanation": "Grammar words are said quickly."
        },
        {
          "id": "sentence-stress-k5",
          "type": "choose",
          "prompt": "Stressing a different word can change the meaning. 'I didn't say HE took it' suggests:",
          "options": [
            "someone else took it",
            "I said nothing",
            "he gave it back"
          ],
          "answer": "someone else took it",
          "explanation": "Stress shows what you are focusing on."
        }
      ]
    },
    {
      "slug": "linking",
      "kind": "linking",
      "title": "Linking words together",
      "symbols": [],
      "tip": "In natural speech, words join. When a word ends in a consonant and the next starts with a vowel, join them: 'turn_off' sounds like 'tur noff'. Between two vowels we often add a small /w/ or /j/: 'go_(w)out', 'see_(j)it'.",
      "examples": [
        "turn off",
        "pick it up",
        "an apple",
        "go out",
        "see it",
        "far away"
      ],
      "drill": [
        {
          "id": "linking-k1",
          "type": "choose",
          "prompt": "How is 'an apple' usually said?",
          "options": [
            "a-napple",
            "an... apple (with a pause)"
          ],
          "answer": "a-napple",
          "explanation": "Consonant + vowel: link them."
        },
        {
          "id": "linking-k2",
          "type": "choose",
          "prompt": "Which sound links 'go out'?",
          "options": [
            "a small w",
            "a small j",
            "a t"
          ],
          "answer": "a small w",
          "explanation": "After an oo-type sound, a small /w/ links the words."
        },
        {
          "id": "linking-k3",
          "type": "choose",
          "prompt": "Which sound links 'see it'?",
          "options": [
            "a small j (y)",
            "a small w",
            "an h"
          ],
          "answer": "a small j (y)",
          "explanation": "After an ee-type sound, a small /j/ links the words."
        },
        {
          "id": "linking-k4",
          "type": "choose",
          "prompt": "'Pick it up' often sounds like:",
          "options": [
            "pi-ki-tup",
            "pick... it... up"
          ],
          "answer": "pi-ki-tup",
          "explanation": "Each consonant joins the next vowel."
        },
        {
          "id": "linking-k5",
          "type": "choose",
          "prompt": "Why learn linking?",
          "options": [
            "to understand and sound like fluent speakers",
            "to speak more slowly",
            "to spell better"
          ],
          "answer": "to understand and sound like fluent speakers",
          "explanation": "Linking is part of natural connected speech."
        }
      ]
    },
    {
      "slug": "intonation",
      "kind": "intonation",
      "title": "Intonation: up and down",
      "symbols": [],
      "tip": "Intonation is the music of speech. The voice usually goes down at the end of statements and wh- questions (Where do you LIVE↘). It often goes up at the end of yes/no questions (Do you live HERE↗) and in lists until the last item.",
      "examples": [
        "Where do you live?",
        "Do you live here?",
        "I'd like tea, coffee and cake."
      ],
      "drill": [
        {
          "id": "intonation-k1",
          "type": "choose",
          "prompt": "Does the voice usually go up or down at the end of 'What's your name?'",
          "options": [
            "down",
            "up"
          ],
          "answer": "down",
          "explanation": "Wh- questions usually fall."
        },
        {
          "id": "intonation-k2",
          "type": "choose",
          "prompt": "Does the voice usually go up or down at the end of 'Are you ready?'",
          "options": [
            "up",
            "down"
          ],
          "answer": "up",
          "explanation": "Yes/no questions often rise."
        },
        {
          "id": "intonation-k3",
          "type": "choose",
          "prompt": "In 'apples, oranges and pears', where does the voice fall?",
          "options": [
            "on pears",
            "on apples",
            "on oranges"
          ],
          "answer": "on pears",
          "explanation": "In a list the voice rises on each item and falls on the last."
        },
        {
          "id": "intonation-k4",
          "type": "choose",
          "prompt": "A statement like 'I'm from Spain' usually ends:",
          "options": [
            "falling",
            "rising"
          ],
          "answer": "falling",
          "explanation": "Statements usually fall."
        },
        {
          "id": "intonation-k5",
          "type": "choose",
          "prompt": "Saying 'You're leaving?' with a rise shows:",
          "options": [
            "surprise or a question",
