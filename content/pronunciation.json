    {
      "slug": "schwa",
      "kind": "vowel",
      "title": "The weak sound: schwa",
      "symbols": [
        "ə"
      ],
      "tip": "Schwa /ə/ is the most common sound in English. It is short and relaxed, like a quiet 'uh'. It appears in unstressed syllables: the a in about, the er in teacher, the o in today.",
      "examples": [
        "about",
        "teacher",
        "banana",
        "today",
        "sofa",
        "problem"
      ],
      "drill": [
        {
          "id": "schwa-k1",
          "type": "choose",
          "prompt": "Where is the schwa in 'about'?",
          "options": [
            "the first a",
            "the ou",
            "the t"
          ],
          "answer": "the first a",
          "explanation": "a-BOUT: the unstressed first syllable is a schwa."
        },
        {
          "id": "schwa-k2",
          "type": "choose",
          "prompt": "Which word ends with a schwa sound?",
          "options": [
            "teacher",
            "tree",
            "go"
          ],
          "answer": "teacher",
          "explanation": "The -er in teacher is a schwa in British English."
        },
        {
          "id": "schwa-k3",
          "type": "choose",
          "prompt": "Is schwa usually in stressed or unstressed syllables?",
          "options": [
            "unstressed",
            "stressed"
          ],
          "answer": "unstressed",
          "explanation": "Schwa is the weak, unstressed sound."
        },
        {
          "id": "schwa-k4",
          "type": "choose",
          "prompt": "How is 'to' usually said in 'I want to go'?",
          "options": [
            "with a schwa: /tə/",
            "with a long oo: /tuː/"
          ],
          "answer": "with a schwa: /tə/",
          "explanation": "Small grammar words are often weak."
        },
        {
          "id": "schwa-k5",
          "type": "choose",
          "prompt": "Which syllable in 'banana' is NOT a schwa?",
          "options": [
            "the middle one",
            "the first one",
            "the last one"
          ],
          "answer": "the middle one",
          "explanation": "ba-NA-na: the stressed middle syllable is a full vowel."
        }
      ]
    },
