# Copy to .env (`make setup` does this and fills in the local Supabase keys).
# Everything here is for LOCAL use only. No cloud accounts or API keys are needed.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Supabase (from `supabase status`). The anon key is public by design.
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
POSTGRES_PASSWORD=postgres

# API
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
RATE_LIMIT_PER_MINUTE=120

# AI providers: local | mock. mock needs nothing. local needs `uv sync --group ai` (speech, embeddings)
# and `docker compose --profile ai up` (LanguageTool, Ollama). See docs/AI_MODELS.md.
STT_PROVIDER=mock
PRONUNCIATION_PROVIDER=mock
FLUENCY_PROVIDER=mock
TTS_PROVIDER=mock
GRAMMAR_PROVIDER=mock
EMBEDDER_PROVIDER=mock
LLM_PROVIDER=mock
LLM_MODEL=qwen3:4b
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LANGUAGETOOL_URL=http://127.0.0.1:8010
OLLAMA_URL=http://127.0.0.1:11434
AI_TIMEOUT_SECONDS=60

# Speaking recordings: saved only on this computer (default <repo>/recordings, git-ignored)
RECORDINGS_DIR=
MAX_RECORDING_BYTES=3000000
EVALUATIONS_PER_DAY=200
EVALUATION_WORKER=true
